# ============================================================
# Hacker House Goa 2026 — Frame Generator
# Environment variables
# ============================================================
#
# All variables are prefixed with VITE_ so they are inlined into
# the browser bundle at build time. They are PUBLIC values (no
# secrets). For Supabase, use only the anon key — never the
# service_role key — so that users cannot bypass RLS.
#
# The app works WITHOUT these (download + data-URL share).
# With these, the share-to-X flow uses a real public image URL
# that X's crawler can render as the link preview.
# ============================================================

# Supabase project URL (https://xxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon / public key
VITE_SUPABASE_ANON_KEY=

# Supabase Storage bucket name. The bucket must be PUBLIC and the
# anon key must have permission to upload. See README for the
# exact storage policy SQL.
VITE_SUPABASE_BUCKET=hh-goa-2026
